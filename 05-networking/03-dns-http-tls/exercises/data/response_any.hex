# example.com のさまざまなレコード（権威サーバーの応答の例）: NS、TXT が 2 つ、CAA
#
# ヘッダ（オフセット 0〜11）
77 77                         # ID
84 00                         # フラグ: QR=1 AA=1 RD=0 RA=0 RCODE=0
00 01 00 04 00 00 00 00       # 質問 1、回答 4、権威 0、追加 0
# 質問（オフセット 12）
07 65 78 61 6d 70 6c 65       # "example"（オフセット 12）
03 63 6f 6d                   # "com"（オフセット 20）
00                            # ルート
00 ff 00 01                   # タイプ ANY (255)、クラス IN
# 回答 1（オフセット 29）: NS ns1.example.com
c0 0c 00 02 00 01 00 01 51 80 # 名前 → example.com、タイプ NS、クラス IN、TTL 86400
00 06                         # RDATA の長さ 6
03 6e 73 31                   # "ns1"（オフセット 41）
c0 0c                         # ポインタ → example.com
# 回答 2（オフセット 47）: TXT "v=spf1 -all"
c0 0c 00 10 00 01 00 00 0e 10 # 名前 → example.com、タイプ TXT (16)、クラス IN、TTL 3600
00 0c                         # RDATA の長さ 12
0b 76 3d 73 70 66 31 20 2d 61 6c 6c # 長さ 11 の文字列 "v=spf1 -all"
# 回答 3（オフセット 71）: TXT "hello" "world"（1 つのレコードに 2 つの文字列）
c0 0c 00 10 00 01 00 00 0e 10 # 名前 → example.com、タイプ TXT、クラス IN、TTL 3600
00 0c                         # RDATA の長さ 12
05 68 65 6c 6c 6f             # "hello"
05 77 6f 72 6c 64             # "world"
# 回答 4（オフセット 95）: CAA 0 issue "letsencrypt.org"
c0 0c 01 01 00 01 00 00 0e 10 # 名前 → example.com、タイプ CAA (257)、クラス IN、TTL 3600
00 16                         # RDATA の長さ 22
00                            # フラグ 0
05 69 73 73 75 65             # タグの長さ 5、"issue"
6c 65 74 73 65 6e 63 72 79 70 74 2e 6f 72 67 # 値 "letsencrypt.org"（この CA だけが証明書を発行してよい）
