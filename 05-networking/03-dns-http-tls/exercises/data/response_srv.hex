# _imaps._tcp.example.com の SRV レコードを問い合わせた応答
#
# ヘッダ（オフセット 0〜11）
5a 5a                         # ID
81 80                         # フラグ: QR=1 RD=1 RA=1 RCODE=0
00 01 00 01 00 00 00 00       # 質問 1、回答 1、権威 0、追加 0
# 質問（オフセット 12）
06 5f 69 6d 61 70 73          # "_imaps"（オフセット 12）
04 5f 74 63 70                # "_tcp"（オフセット 19）
07 65 78 61 6d 70 6c 65       # "example"（オフセット 24）
03 63 6f 6d                   # "com"（オフセット 32）
00                            # ルート
00 21 00 01                   # タイプ SRV (33)、クラス IN
# 回答（オフセット 41）: 優先度 0、重み 1、ポート 993、ターゲット mail.example.com
c0 0c 00 21 00 01 00 00 0e 10 # 名前 → _imaps._tcp.example.com、タイプ SRV、クラス IN、TTL 3600
00 0d                         # RDATA の長さ 13
00 00 00 01 03 e1             # 優先度 0、重み 1、ポート 993
04 6d 61 69 6c                # "mail"（オフセット 59）
c0 18                         # ポインタ → オフセット 24（example.com）
