# www.example.com の A レコードを問い合わせた応答（CNAME を経由する）
# 「#」から行末まではコメント。テストは 16 進数の部分だけを読みます。
#
# ヘッダ（オフセット 0〜11）
be ef                         # ID
81 80                         # フラグ: QR=1 OPCODE=0 AA=0 TC=0 RD=1 RA=1 RCODE=0
00 01 00 02 00 00 00 01       # 質問 1、回答 2、権威 0、追加 1
# 質問（オフセット 12）
03 77 77 77                   # "www"（オフセット 12）
07 65 78 61 6d 70 6c 65       # "example"（オフセット 16）
03 63 6f 6d                   # "com"（オフセット 24）
00                            # ルート（名前の終わり）
00 01 00 01                   # タイプ A、クラス IN
# 回答 1（オフセット 33）: www.example.com CNAME web.example.com
c0 0c                         # 名前: 圧縮ポインタ → オフセット 12（www.example.com）
00 05 00 01                   # タイプ CNAME、クラス IN
00 00 0e 10                   # TTL 3600 秒
00 06                         # RDATA の長さ 6
03 77 65 62                   # "web"（オフセット 45）← RDATA の先頭
c0 10                         # ポインタ → オフセット 16（example.com）
# 回答 2（オフセット 51）: web.example.com A 192.0.2.10
c0 2d                         # 名前: ポインタ → オフセット 45（web.example.com。その先にさらにポインタがある）
00 01 00 01                   # タイプ A、クラス IN
00 00 00 3c                   # TTL 60 秒
00 04                         # RDATA の長さ 4
c0 00 02 0a                   # 192.0.2.10
# 追加（オフセット 67）: EDNS(0) の OPT 疑似レコード
00                            # 名前: ルート
00 29                         # タイプ OPT (41)
04 d0                         # 「クラス」欄 = 受け取れる UDP ペイロードの大きさ 1232 バイト
00 00 00 00                   # 「TTL」欄 = 拡張 RCODE・バージョン・フラグ
00 00                         # RDATA の長さ 0
