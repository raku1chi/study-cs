# example.com の MX レコードを問い合わせた応答（権威サーバーから。追加セクションに A と AAAA）
#
# ヘッダ（オフセット 0〜11）
12 34                         # ID
85 80                         # フラグ: QR=1 AA=1 RD=1 RA=1 RCODE=0
00 01 00 02 00 00 00 02       # 質問 1、回答 2、権威 0、追加 2
# 質問（オフセット 12）
07 65 78 61 6d 70 6c 65       # "example"（オフセット 12）
03 63 6f 6d                   # "com"（オフセット 20）
00                            # ルート
00 0f 00 01                   # タイプ MX、クラス IN
# 回答（オフセット 29）: example.com MX 10 mx1.example.com
c0 0c                         # 名前: ポインタ → オフセット 12（example.com）
00 0f 00 01 00 00 0e 10       # タイプ MX、クラス IN、TTL 3600
00 08                         # RDATA の長さ 8
00 0a                         # 優先度 10（小さいほど優先）
03 6d 78 31                   # "mx1"（オフセット 43）
c0 0c                         # ポインタ → example.com
# 回答（オフセット 49）: example.com MX 20 mx2.example.com
c0 0c                         # 名前: ポインタ → オフセット 12（example.com）
00 0f 00 01 00 00 0e 10       # タイプ MX、クラス IN、TTL 3600
00 08                         # RDATA の長さ 8
00 14                         # 優先度 20（小さいほど優先）
03 6d 78 32                   # "mx2"（オフセット 63）
c0 0c                         # ポインタ → example.com
# 追加 1（オフセット 69）: mx1.example.com A 192.0.2.25
c0 2b                         # 名前: ポインタ → オフセット 43（mx1.example.com）
00 01 00 01 00 00 0e 10       # タイプ A、クラス IN、TTL 3600
00 04                         # RDATA の長さ 4
c0 00 02 19                   # 192.0.2.25
# 追加 2（オフセット 85）: mx1.example.com AAAA 2001:db8::25
c0 2b                         # 名前: ポインタ → オフセット 43
00 1c 00 01 00 00 0e 10       # タイプ AAAA (28)、クラス IN、TTL 3600
00 10                         # RDATA の長さ 16
20 01 0d b8 00 00 00 00 00 00 00 00 00 00 00 25 # 2001:db8::25
